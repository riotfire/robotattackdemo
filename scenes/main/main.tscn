[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/systems/main.gd" id="1_main"]
[ext_resource type="PackedScene" path="res://scenes/farm/farm.tscn" id="2_farm"]
[ext_resource type="Script" path="res://scripts/systems/player_spawner.gd" id="3_spawner"]
[ext_resource type="PackedScene" path="res://scenes/player/farmer.tscn" id="4_farmer"]
[ext_resource type="Script" path="res://scripts/systems/wave_director.gd" id="5_director"]
[ext_resource type="Resource" path="res://data/difficulty/default_difficulty.tres" id="6_curve"]
[ext_resource type="Script" path="res://scripts/ai/robot_archetype.gd" id="7_archetype"]
[ext_resource type="Resource" path="res://data/robots/archetypes/nibbler.tres" id="8_nibbler"]
[ext_resource type="Resource" path="res://data/robots/archetypes/clanker.tres" id="11_clanker"]
[ext_resource type="Resource" path="res://data/robots/archetypes/thumper.tres" id="12_thumper"]
[ext_resource type="Resource" path="res://data/robots/gene_library.tres" id="13_genes"]
[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="9_hud"]
[ext_resource type="Script" path="res://scripts/systems/debug_cheats.gd" id="10_cheats"]
[ext_resource type="Script" path="res://scripts/ui/pegboard_ui.gd" id="14_pegboard"]

[node name="Main" type="Node3D"]
script = ExtResource("1_main")

[node name="Farm" parent="." instance=ExtResource("2_farm")]

[node name="Robots" type="Node3D" parent="."]

[node name="Players" type="Node3D" parent="."]

[node name="PlayerSpawner" type="Node" parent="." node_paths=PackedStringArray("players_parent")]
script = ExtResource("3_spawner")
player_scene = ExtResource("4_farmer")
players_parent = NodePath("../Players")

[node name="WaveDirector" type="Node" parent="." node_paths=PackedStringArray("robots_parent")]
script = ExtResource("5_director")
curve = ExtResource("6_curve")
archetypes = Array[ExtResource("7_archetype")]([ExtResource("8_nibbler"), ExtResource("11_clanker"), ExtResource("12_thumper")])
foreman_archetype = ExtResource("12_thumper")
gene_library = ExtResource("13_genes")
robots_parent = NodePath("../Robots")

[node name="HUD" type="CanvasLayer" parent="." node_paths=PackedStringArray("director")]
script = ExtResource("9_hud")
director = NodePath("../WaveDirector")

[node name="Pegboard" type="CanvasLayer" parent="." node_paths=PackedStringArray("director")]
script = ExtResource("14_pegboard")
director = NodePath("../WaveDirector")

[node name="DebugCheats" type="Node" parent="." node_paths=PackedStringArray("director", "hud")]
script = ExtResource("10_cheats")
director = NodePath("../WaveDirector")
hud = NodePath("../HUD")
