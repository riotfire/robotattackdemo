[sub_resource type="BTDynamicSequence" id="BTDynamicSequence_eh71b"]
custom_name = "Melee"
children = [SubResource("BTAction_2c3dw"), SubResource("BTDynamicSelector_hs57f")]

[resource]
description = "Melee class (GDD 9.6): the Nibbler, Clanker and Thumper. Every tick, [b]TrackTarget[/b] keeps the farmer target current, gives up on a farmer perched out of reach, and marks where to wait for one. Then the first branch that can run takes over: a hit (windup, strike, recovery) on the silo or the farmer once in reach; a thief's sack grab at the chute and its run for the corn; a squad follower keeping its slot in the triangle while the leader is far from the target; otherwise walking to the target. A started hit or theft always plays out: its branch comes first and is a plain sequence, so nothing interrupts it. The formation branch is a dynamic sequence: followers break formation the moment the leader nears the target."
blackboard_plan = SubResource("BlackboardPlan_1ynov")
root_task = SubResource("BTDynamicSequence_eh71b")
