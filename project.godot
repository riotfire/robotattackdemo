[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Robots"
3d_physics/layer_4="PlayerHurtbox"
3d_physics/layer_5="RobotHurtbox"
3d_physics/layer_6="Silo"
3d_physics/layer_7="Pickups"
3d_physics/layer_8="Interactables"
3d_physics/layer_9="Projectiles"
3d_physics/layer_10="CameraCollision"

[navigation]

3d/default_cell_height=0.05

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/msaa_3d=1
scaling_3d/scale=0.5

[shader_globals]

clay_boil_frame={
"type": "float",
"value": 0.0
}
clay_boil_enabled={
"type": "float",
"value": 1.0
}
