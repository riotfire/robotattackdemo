; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Robot Attack!"
config/description="Cute claymation third-person wave-defense shooter. M0 graybox prototype."
run/main_scene="res://scenes/ui/boot_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
RngService="*res://scripts/autoload/rng_service.gd"
StopMotionClock="*res://scripts/autoload/stop_motion_clock.gd"
GameState="*res://scripts/autoload/game_state.gd"
StatService="*res://scripts/autoload/stat_service.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
AudioDirector="*res://scripts/autoload/audio_director.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=0
window/size/mode.template=3

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[gui]

theme/custom_font="res://assets/fonts/fredoka_semibold.tres"

